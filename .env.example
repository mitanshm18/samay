# Copy this file to .env (git-ignored) and fill in the values.
#   cp .env.example .env
# The database is not started until Milestone 1, Step 4.

# Exact PostgreSQL 16 image tag that is ALREADY on your Mac.
# Find it with (read-only):  docker image ls postgres
# compose.yaml uses pull_policy: never, so Docker will refuse to download
# anything; if this tag is not present locally, startup fails instead.
SAMAY_PG_IMAGE=postgres:16

# Password for SAMAY's own local database user. Pick any local-only value.
SAMAY_DB_PASSWORD=change-me-local-only

# Host port for SAMAY's database. Bound to 127.0.0.1 only.
# 55432 avoids 5432, which other projects on this Mac may use.
SAMAY_DB_PORT=55432
